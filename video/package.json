{
  "name": "relevo-ad",
  "private": true,
  "description": "Anuncio de 50 s de Relevo para el pitch (Remotion)",
  "scripts": {
    "capture": "node scripts/capture.cjs",
    "music": "node scripts/music.cjs",
    "render": "remotion render src/index.ts RelevoAd out/relevo-ad.mp4",
    "frames": "node scripts/frames.cjs",
    "studio": "remotion studio src/index.ts",
    "ad": "npm run capture && npm run music && npm run render && npm run frames"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  }
}
